{
  "name": "chad-delivery",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "tsc -p tsconfig.test.json && node --test \"tests/*.test.cjs\"",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/release-check.cjs",
    "release:verify": "npm test && npm run typecheck && npm run release:check",
    "legal:build": "tsc -p tsconfig.test.json && node scripts/build-legal.cjs",
    "test:sql": "zsh scripts/test-sql.sh",
    "legal:deploy": "zsh scripts/legal-deploy.sh"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
