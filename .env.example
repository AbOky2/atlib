# Public delivery support contact; international Chad format, no spaces.
# Set the real value in the EAS production environment before building.
EXPO_PUBLIC_SUPPORT_PHONE=

# Path provided by an EAS file variable containing Firebase google-services.json.
# This is NOT the private FCM service-account key, which belongs in EAS credentials.
GOOGLE_SERVICES_JSON=

# Identity shown in the privacy policy (in-app screen and legal/privacy.html).
# Both are required by the store listings; set them in the EAS production environment.
EXPO_PUBLIC_LEGAL_PUBLISHER=
EXPO_PUBLIC_LEGAL_EMAIL=

# Supabase project (public values; RLS is the security boundary). Defaults to the
# live project when unset, so a preview build can target another project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
